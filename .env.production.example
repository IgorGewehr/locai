# ============================================================
# LOCAI — Production Environment
# ============================================================
# Copy to .env.production — NEVER commit this file!
# ============================================================

# Firebase Client
NEXT_PUBLIC_FIREBASE_PROJECT_ID=locai-76dcf
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=locai-76dcf.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=locai-76dcf.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=locai-76dcf
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@locai-76dcf.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Security
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-locai-domain.com

# Python Agent (internal Docker)
AGENT_SERVICE_URL=http://agent:8080
AGENT_SHARED_SECRET=                # openssl rand -hex 32

# WhatsApp Microservice (internal Docker)
WHATSAPP_MICROSERVICE_URL=http://whatsapp:3000
WHATSAPP_MICROSERVICE_API_KEY=      # same as API_KEY in whatsapp_microservice/.env.production
WHATSAPP_WEBHOOK_SECRET=            # openssl rand -hex 32

# Redis (internal Docker)
REDIS_URL=redis://redis:6379

# Google Maps (optional, for property address)
MAPS_KEY=

# Cron secret
CRON_SECRET=

# Feature flags
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_AI_AGENT=true
ENABLE_PAYMENT_PROCESSING=false
ENABLE_ANALYTICS=true

# App URL (Cloudflare tunnel public URL)
NEXT_PUBLIC_APP_URL=https://your-locai-domain.com
NEXT_PUBLIC_BASE_URL=https://your-locai-domain.com

NODE_ENV=production
LOG_LEVEL=info
