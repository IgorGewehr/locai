# ============================================================
# LOCAI - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials!
# ============================================================

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (Server-side)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# N8N INTEGRATION (Sofia AI Workflow)
# ============================================================
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-webhook-id
N8N_WEBHOOK_SECRET=your-webhook-secret
N8N_API_KEY=your-n8n-api-key

# ============================================================
# OPENAI CONFIGURATION (Sofia Agent)
# ============================================================
OPENAI_API_KEY=sk-proj-your-openai-api-key
AGENT_MODEL_SIMPLE=gpt-4o-mini
AGENT_MODEL_COMPLEX=gpt-4o-mini

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# Tenant Configuration (multi-tenant)
TENANT_ID=default
NEXT_PUBLIC_TENANT_ID=default

# ============================================================
# SECURITY CONFIGURATION
# ============================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-characters
NEXTAUTH_SECRET=your-nextauth-secret-min-32-characters
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_AI_AGENT=true
ENABLE_PAYMENT_PROCESSING=false
ENABLE_ANALYTICS=true
PROFESSIONAL_AGENT_ENABLED=true

# ============================================================
# PERFORMANCE CONFIGURATION
# ============================================================
CACHE_TTL_SECONDS=300
MAX_CONCURRENT_AI_REQUESTS=10
AI_REQUEST_TIMEOUT_MS=30000

# ============================================================
# GOOGLE MAPS
# ============================================================
MAPS_KEY=your-google-maps-api-key

# ============================================================
# RATE LIMITING
# ============================================================
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
NEXT_PUBLIC_DEBUG_MODE=true

# ============================================================
# WHATSAPP INTEGRATION
# ============================================================
# Local WhatsApp Web (Baileys) - for development
DISABLE_WHATSAPP_WEB=false
ENABLE_WHATSAPP_WEB=true

# External WhatsApp Microservice (Production)
WHATSAPP_USE_EXTERNAL=false
WHATSAPP_MICROSERVICE_URL=http://your-whatsapp-server:3000
WHATSAPP_MICROSERVICE_API_KEY=your-microservice-api-key

# ============================================================
# CRON JOBS
# ============================================================
# Generate with: node scripts/generate-cron-secret.js
CRON_SECRET=your-cron-secret

# ============================================================
# REDIS (Optional - for AI blocks caching)
# ============================================================
# REDIS_URL=redis://default:password@your-redis-host:port

# ============================================================
# FACEBOOK/INSTAGRAM INTEGRATION (Optional)
# ============================================================
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_VERIFY_TOKEN=your-verify-token

# ============================================================
# ABACATEPAY (Payment Processing - Optional)
# ============================================================
# ABACATEPAY_API_KEY=your-abacatepay-api-key
# ABACATEPAY_WEBHOOK_SECRET=your-webhook-secret
