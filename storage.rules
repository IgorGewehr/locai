rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tenant-scoped files — read/write only for users belonging to the tenant
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == tenantId || request.auth.token.tenantId == tenantId);
      allow write: if request.auth != null &&
        (request.auth.uid == tenantId || request.auth.token.tenantId == tenantId) &&
        request.resource.size < 100 * 1024 * 1024;
    }

    // Legacy paths — tenant-scoped via metadata or auth
    match /properties/{tenantId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == tenantId || request.auth.token.tenantId == tenantId);
      allow write: if request.auth != null &&
        (request.auth.uid == tenantId || request.auth.token.tenantId == tenantId) &&
        request.resource.size < 50 * 1024 * 1024;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
