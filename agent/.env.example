# ============================================================
# Locai Agent — Environment Variables
# ============================================================
# Copy to .env.production and fill in values.
# Never commit real credentials!
# ============================================================

# --- Auth (must match locai AGENT_SHARED_SECRET) ---
AGENT_SHARED_SECRET=generate-with-openssl-rand-hex-32

# --- LLM Provider ---
# Choose "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Model selection
MODEL_FAST=gpt-4o-mini
MODEL_MAIN=gpt-4o-mini

# --- Locai backend ---
# Internal Docker URL when running in compose; localhost:3000 for local dev
LOCAI_API_URL=http://locai:3000

# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
APP_ENV=production

# --- Safety ---
AGENT_MAX_ITERATIONS=8
AGENT_REQUEST_TIMEOUT_S=30

# --- LangSmith (optional but recommended) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=locai-agent-prod
# REDACT_PII_IN_TRACES=true
