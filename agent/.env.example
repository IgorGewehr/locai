# --- Core (required) ---
AGENT_SHARED_SECRET=replace-with-strong-random-secret
OPENAI_API_KEY=sk-...
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# --- Environment ---
APP_ENV=development

# --- Models (3-tier) ---
OPENAI_MODEL_ROUTER=gpt-4o-mini
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o

# --- Server ---
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO

# --- Safety ---
AGENT_MAX_ITERATIONS=8
AGENT_REQUEST_TIMEOUT_S=30

# --- LangSmith (optional) ---
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=locai-dev

# --- Privacy ---
REDACT_PII_IN_TRACES=true
